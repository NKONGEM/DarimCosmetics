# ── Clerk (authentication for the /admin dashboard) ──────────────────────
# Get these from https://dashboard.clerk.com after creating a free Clerk app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk should send people to sign in / after sign in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# ── WhatsApp ordering ─────────────────────────────────────────────────────
# The number customers' "Order on WhatsApp" button messages, in international
# format with no +, spaces or leading zero, e.g. Kenyan 0700 123 456 -> 254700123456
NEXT_PUBLIC_WHATSAPP_NUMBER=254700123456
