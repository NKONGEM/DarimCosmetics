{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darim-cosmetics",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "darim-cosmetics"
    }
  ],
  // The free Cloudflare D1 database that stores products, categories,
  // pages and settings. You create the real one when you deploy (see the
  // deployment guide) and paste its ID below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "darim-luxe-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
